//Задание 1 

#include <stdio.h>
#include <stdlib.h>
#include <omp.h>

#define N 100000000

int main() {
    int threads = 1;  // 1, 2, 4, 8, 16
    omp_set_num_threads(threads);

    double* arr = (double*)malloc(N * sizeof(double));
    if (arr == NULL) {
        printf("Memory allocation failed\n");
        return 1;
    }

    for (int i = 0; i < N; i++) {
        arr[i] = rand() % 100;
    }

    double sum = 0.0;
    double start = omp_get_wtime();

#pragma omp parallel for reduction(+:sum)
    for (int i = 0; i < N; i++) {
        sum += arr[i];
    }

    double end = omp_get_wtime();

    printf("Sum = %.6f\n", sum);
    printf("Threads used = %d\n", threads);
    printf("Time = %f seconds\n", end - start);

    free(arr);
    return 0;
}


//Задание 2
#include <stdio.h>
#include <stdlib.h>
#include <omp.h>

#define N 5000000
#define THRESHOLD 1000

void swap(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

int partition(int* arr, int left, int right) {
    int pivot = arr[right];
    int i = left - 1;
    for (int j = left; j < right; j++) {
        if (arr[j] <= pivot) {
            i++;
            swap(&arr[i], &arr[j]);
        }
    }
    swap(&arr[i + 1], &arr[right]);
    return i + 1;
}

void quick_sort_sequential(int* arr, int left, int right) {
    if (left < right) {
        int pivot = partition(arr, left, right);
        quick_sort_sequential(arr, left, pivot - 1);
        quick_sort_sequential(arr, pivot + 1, right);
    }
}

void quick_sort_parallel(int* arr, int left, int right) {
    if (right - left < THRESHOLD) {
        quick_sort_sequential(arr, left, right);
        return;
    }
    if (left < right) {
        int pivot = partition(arr, left, right);
#pragma omp task
        quick_sort_parallel(arr, left, pivot - 1);
#pragma omp task
        quick_sort_parallel(arr, pivot + 1, right);
#pragma omp taskwait
    }
}

int main() {
    int threads = 1;  // 1, 2, 4, 8, 16
    omp_set_num_threads(threads);

    int* arr = (int*)malloc(N * sizeof(int));
    if (arr == NULL) {
        printf("Memory allocation failed\n");
        return 1;
    }

    for (int i = 0; i < N; i++) {
        arr[i] = rand() % 10000000;
    }

    double start = omp_get_wtime();

#pragma omp parallel
    {
#pragma omp single
        quick_sort_parallel(arr, 0, N - 1);
    }

    double end = omp_get_wtime();

    printf("Threads used = %d\n", threads);
    printf("Time = %f seconds\n", end - start);

    free(arr);
    return 0;
}


//Задание 3
#include <stdio.h>
#include <stdlib.h>
#include <omp.h>

#define N 100000000

int main() {
    int threads = 1;  // 1, 2, 4, 8, 16
    omp_set_num_threads(threads);

    double* a = (double*)malloc(N * sizeof(double));
    double* b = (double*)malloc(N * sizeof(double));
    double* c_add = (double*)malloc(N * sizeof(double));
    double* c_sub = (double*)malloc(N * sizeof(double));
    double* c_mul = (double*)malloc(N * sizeof(double));
    double* c_div = (double*)malloc(N * sizeof(double));

    if (!a || !b || !c_add || !c_sub || !c_mul || !c_div) {
        printf("Memory allocation failed\n");
        return 1;
    }

    for (int i = 0; i < N; i++) {
        a[i] = rand() % 100;
        b[i] = rand() % 100 + 1;
    }

    double start = omp_get_wtime();

#pragma omp parallel for
    for (int i = 0; i < N; i++) {
        c_add[i] = a[i] + b[i];
        c_sub[i] = a[i] - b[i];
        c_mul[i] = a[i] * b[i];
        c_div[i] = a[i] / b[i];
    }

    double end = omp_get_wtime();

    printf("Threads used = %d\n", threads);
    printf("Time = %f seconds\n", end - start);

    free(a); free(b); free(c_add); free(c_sub); free(c_mul); free(c_div);
    return 0;
}


//Задание 4
#include <stdio.h>
#include <stdlib.h>
#include <omp.h>

#define M 1000
#define N 1000
#define K 1000

int main() {
    int threads = 1;  // 1, 2, 4, 8, 16
    omp_set_num_threads(threads);

    double** A = (double**)malloc(M * sizeof(double*));
    double** B = (double**)malloc(N * sizeof(double*));
    double** C = (double**)malloc(M * sizeof(double*));

    for (int i = 0; i < M; i++) A[i] = (double*)malloc(N * sizeof(double));
    for (int i = 0; i < N; i++) B[i] = (double*)malloc(K * sizeof(double));
    for (int i = 0; i < M; i++) C[i] = (double*)calloc(K, sizeof(double));

    for (int i = 0; i < M; i++)
        for (int j = 0; j < N; j++)
            A[i][j] = rand() % 100;

    for (int i = 0; i < N; i++)
        for (int j = 0; j < K; j++)
            B[i][j] = rand() % 100;

    double start = omp_get_wtime();

#pragma omp parallel for
    for (int i = 0; i < M; i++) {
        for (int j = 0; j < K; j++) {
            double sum = 0.0;
            for (int t = 0; t < N; t++) {
                sum += A[i][t] * B[t][j];
            }
            C[i][j] = sum;
        }
    }

    double end = omp_get_wtime();

    printf("Threads used = %d\n", threads);
    printf("Time = %f seconds\n", end - start);

    for (int i = 0; i < M; i++) free(A[i]);
    for (int i = 0; i < N; i++) free(B[i]);
    for (int i = 0; i < M; i++) free(C[i]);
    free(A); free(B); free(C);

    return 0;
}
